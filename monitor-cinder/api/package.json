{
  "name": "monitor-cinder-api",
  "version": "1.0.0",
  "description": "Monitor Cinder Backend — MODIS & VIIRS Harmonization, Root Fire Calendar & NASA POWER Predictability",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "job:load-regions": "tsx src/jobs/load-regions.ts",
    "job:ingest-firms": "tsx src/jobs/ingest-firms.ts",
    "job:harmonize": "tsx src/jobs/harmonize.ts",
    "job:build-calendar": "tsx src/jobs/build-calendar.ts",
    "job:ingest-context": "tsx src/jobs/ingest-context.ts",
    "job:train-ml": "tsx src/jobs/train-ml.ts",
    "job:forecast": "tsx src/jobs/forecast.ts",
    "job:pipeline": "tsx src/jobs/run-pipeline.ts",
    "job:db-load-regions": "tsx src/jobs/db-load-regions.ts",
    "job:ingest-firms-history": "tsx src/jobs/ingest-firms-history.ts",
    "job:build-history": "tsx src/jobs/build-history.ts",
    "job:build-cell-index": "tsx src/jobs/build-cell-index.ts",
    "test:db": "vitest run src/tests/history.db.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
