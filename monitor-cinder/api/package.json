{
  "name": "monitor-cinder-api",
  "version": "1.0.0",
  "description": "Monitor Cinder API: MODIS and VIIRS (NASA FIRMS) hotspot harmonization for Goiás",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "job:load-regions": "tsx src/jobs/load-regions.ts",
    "job:harmonize": "tsx src/jobs/harmonize.ts",
    "job:forecast": "tsx src/jobs/forecast.ts",
    "job:db-load-regions": "tsx src/jobs/db-load-regions.ts",
    "job:ingest-firms-history": "tsx src/jobs/ingest-firms-history.ts",
    "job:build-history": "tsx src/jobs/build-history.ts",
    "job:build-cell-index": "tsx src/jobs/build-cell-index.ts",
    "test:db": "vitest run src/tests/history.db.test.ts",
    "job:validate": "tsx src/jobs/validate.ts",
    "job:goes-check": "tsx src/jobs/goes-check.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "fastify": "^4.28.1",
    "h5wasm": "^0.7.9",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
