# Monitor Cinder Backend Environment (.env.example)
PORT=8787
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8080
DATABASE_URL=postgresql://cinder:cinder@localhost:5432/cinder
FIRMS_MAP_KEY=
EMBRAPA_CONSUMER_KEY=
EMBRAPA_CONSUMER_SECRET=
GOIAS_BBOX=-53.25,-19.50,-45.90,-12.39
# Optional LLM for the assistant. Without a key it runs in no-LLM mode (keyword routing + templates).
# Gemini wins when both are set. Get a key at https://aistudio.google.com/apikey and never commit it.
GEMINI_API_KEY=
# GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
# GEMINI_WRITER_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
# OPENAI_ROUTER_MODEL=gpt-4o-mini
# OPENAI_WRITER_MODEL=gpt-4o
ANTHROPIC_API_KEY=
# ANTHROPIC_ROUTER_MODEL=claude-haiku-5-5
# ANTHROPIC_WRITER_MODEL=claude-sonnet-5-5
# Order of preference among the keys that are set; the next one is used when the first fails.
# LLM_PROVIDERS=gemini,openai,anthropic
